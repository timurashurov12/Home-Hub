# Порт панели (http://localhost:8765)
TVHUB_PORT=8765
# Подсети для поиска устройств через запятую. Пусто — подсети сетевых интерфейсов.
# Для docker-compose.bridge.yml (Docker Desktop) обязательно, напр. 192.168.1.0
# SCAN_SUBNETS=192.168.1.0
# Порт Redis для docker-compose.yml (host-сеть). В bridge-варианте порт наружу не публикуется.
# TVHUB_REDIS_PORT=6390
# Сколько миллисекунд отдавать снимок мониторинга из кеша
# STATS_CACHE_MS=4000
# Фоновый сбор мониторинга для всех онлайн-ТВ, мс (0 — выключить)
# STATS_BG_INTERVAL_MS=60000
# Токен GitHub (без прав, только чтение публичных репозиториев) — снимает лимит 60 запросов в час при проверке обновлений
# GITHUB_TOKEN=
